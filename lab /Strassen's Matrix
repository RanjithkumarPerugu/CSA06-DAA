
#include <stdio.h>

#define N 2

void strassen(int A[N][N], int B[N][N], int C[N][N])
{
    int M1, M2, M3, M4, M5, M6, M7;

    int a = A[0][0], b = A[0][1];
    int c = A[1][0], d = A[1][1];

    int e = B[0][0], f = B[0][1];
    int g = B[1][0], h = B[1][1];

    M1 = (a + d) * (e + h);
    M2 = (c + d) * e;
    M3 = a * (f - h);
    M4 = d * (g - e);
    M5 = (a + b) * h;
    M6 = (c - a) * (e + f);
    M7 = (b - d) * (g + h);

    C[0][0] = M1 + M4 - M5 + M7;
    C[0][1] = M3 + M5;
    C[1][0] = M2 + M4;
    C[1][1] = M1 - M2 + M3 + M6;
}

int main()
{
    int A[N][N], B[N][N], C[N][N];
    int i, j;

    printf("Enter elements of first matrix:\n");
    for(i = 0; i < N; i++)
    {
        for(j = 0; j < N; j++)
        {
            scanf("%d", &A[i][j]);
        }
    }

    printf("Enter elements of second matrix:\n");
    for(i = 0; i < N; i++)
    {
        for(j = 0; j < N; j++)
        {
            scanf("%d", &B[i][j]);
        }
    }

    strassen(A, B, C);

    printf("\nResultant Matrix:\n");
    for(i = 0; i < N; i++)
    {
        for(j = 0; j < N; j++)
        {
            printf("%d\t", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
