#include <stdio.h>

int main()
{
    int n, i;
    long long a = 0, b = 1, c;

    printf("Enter number of terms (1 to 93): ");
    scanf("%d", &n);

    if (n < 1 || n > 93)
    {
        printf("Enter a number between 1 and 93.");
        return 0;
    }

    printf("Fibonacci series: ");

    for (i = 1; i <= n; i++)
    {
        printf("%lld ", a);

        c = a + b;
        a = b;
        b = c;
    }

    return 0;
}
